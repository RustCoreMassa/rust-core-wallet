<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the wallet goes into a cloud backup or a transfer to a new phone.
     The vault is encrypted with a Keystore key that never leaves this phone anyway; a wallet moves
     to a new phone by importing its private key. (Android 11 and below: allowBackup="false".) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
